# Backend environment variables
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cyberscore
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://YOUR-NETLIFY-SITE.netlify.app
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_APIUSER=your-fapshi-api-user
FAPSHI_APIKEY=your-fapshi-api-key
FAPSHI_WEBHOOK_SECRET=your-fapshi-webhook-secret
